# Copy to .env and fill in. NEVER commit .env.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=service-role-key-here
MFETL_CANON_TARGET=10000
# Only for `mfetl migrate` (database changes). Supabase dashboard -> Connect -> Session pooler,
# with the database password filled in. Not used by the weekly run.
SUPABASE_DB_URL=postgresql://postgres.YOUR-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
